# Copy this to .env in the same directory as docker-compose.yml.

# Password for the local app.
FASHION_PASSWORD=changeme

# Used to sign session cookies. Pick a long random string and don't share it.
# Example: python -c "import secrets; print(secrets.token_urlsafe(32))"
FASHION_SECRET_KEY=please-change-me-to-something-long-and-random

# Port the web UI is exposed on. Default 8080. Change if it's in use.
FASHION_WEB_PORT=8080
